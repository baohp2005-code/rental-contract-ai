# Sao chép thành apps/api/src/.env. Backend chỉ đọc file này và biến môi trường shell.
# Mặc định replay dùng dữ liệu mô phỏng, không cần khóa.
PROVIDER_MODE=replay
OPENAI_API_KEY=
# Chọn model ID có quyền truy cập thực sự trong tài khoản.
OPENAI_MODEL=
# Google: API key HOẶC đường dẫn tuyệt đối đến credentials/ADC.
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
PORT=8787
HOST=0.0.0.0
# Origin web qua IP LAN, ví dụ http://192.168.1.10:8081.
ALLOWED_ORIGINS=
