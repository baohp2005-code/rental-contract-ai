# Sao chép thành apps/api/.env và điền giá trị. Không commit file .env

# ── LLM ─────────────────────────────────────────────────
# claude | openai | none. Bỏ trống thì tự chọn theo key có sẵn; không có key nào thì none.
# none = chế độ không AI: chỉ OCR + quy tắc + từ khóa, không cần key LLM.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# Bắt buộc khi dùng OpenAI: model có quyền dùng, hỗ trợ ảnh và Structured Outputs
OPENAI_MODEL=

# ── OCR Google Vision: chọn một trong hai ───────────────
# Cách 1 (dễ nhất): API key của project đã bật Cloud Vision API và thanh toán
GOOGLE_CLOUD_VISION_API_KEY=
# Cách 2: file service account đặt trong apps/api/ (đã gitignore)
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

PORT=8787
