        "y": 0.4595,
        "w": 0.5669,
        "h": 0.0285
      }
    },
    {
      "id": "p1-L11",
      "page": 1,
      "text": "Điều 3. Tiền đặt cọc: 7.000.000 đồng (hai tháng tiền nhà).",
