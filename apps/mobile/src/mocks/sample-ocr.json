        "x": 0.0839,
        "y": 0.5165,
        "w": 0.6694,
        "h": 0.0285
      }
    },
    {
      "id": "p1-L12",
      "page": 1,
      "text": "Nếu bên B chuyển đi trước hạn thì không được hoàn lại tiền cọc.",
