# Không bắt buộc. Không có file apps/mobile/.env thì app gọi backend chung của nhóm:
#   https://rental-contract-api.onrender.com
# Chỉ tạo file này (sao chép từ file mẫu) khi muốn đổi:
#   Dùng dữ liệu mẫu, không cần mạng (làm giao diện):
#     EXPO_PUBLIC_API_URL=mock
#   Dùng backend chạy trên máy mình (IP ở dòng "Cho điện thoại" khi chạy server):
#     EXPO_PUBLIC_API_URL=http://192.168.1.23:8787
EXPO_PUBLIC_API_URL=
