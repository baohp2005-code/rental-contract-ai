# Sao chép thành apps/mobile/.env. Không có file này thì app chạy bằng dữ liệu mẫu.
# Địa chỉ backend chung của nhóm trên Render (hỏi người deploy), ví dụ:
#   EXPO_PUBLIC_API_URL=https://rental-contract-api.onrender.com
# Hoặc backend chạy trên máy mình (lấy IP ở dòng "Cho điện thoại" khi chạy server):
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:8787
EXPO_PUBLIC_API_URL=
